<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CalendarLite.Resources">
    <!--
      主题资源说明：
      1) 本文件集中定义全局颜色与控件样式，便于统一外观与后续维护。
      2) App 启动时会根据系统明暗模式覆盖部分颜色（见 App.xaml.cs: ApplySystemTheme）。
      3) 修改某一颜色的外观：只需调整对应 SolidColorBrush 的 Color 值即可。
      4) 修改控件圆角/交互：调整 RoundedButton / RoundedComboBox 样式即可。
      5) 若希望在运行时动态切换主题，可在 App 里替换 Resource 字典或更新键值。
    -->

    <!-- 基础颜色（页面背景、文本颜色、周末颜色等） -->
    <SolidColorBrush x:Key="PanelBackground" Color="#ffffffff"/>
    <!-- 面板边框颜色（控制主窗口边框） -->
    <SolidColorBrush x:Key="PanelBorder" Color="#DDDDDD"/>
    <!-- 常规文本颜色（大多数文字） -->
    <SolidColorBrush x:Key="Foreground" Color="#FF030303"/>
    <!-- 轻文本颜色（副标题、次要信息） -->
    <SolidColorBrush x:Key="ForegroundLight" Color="#fc8484d3"/>
    <!-- 周末日期颜色（周六/周日的日期数字） -->
    <!-- 支持插件 RGBA（#RRGGBBAA），自动转换为 WPF 可用的 ARGB -->
    <SolidColorBrush x:Key="Weekend-Foreground" Color="{conv:HexColor Value=#3f79f7c2}"/>

    <SolidColorBrush x:Key="TestColor" Color="#3f79f7c2"/>

    <!-- 月份标题颜色（顶部“YYYY年MM月”） -->
    <SolidColorBrush x:Key="MonthTitleground" Color="#FF1842FD"/>
    <!-- 农历颜色（顶部农历文本） -->
    <SolidColorBrush x:Key="LunarColor" Color="#666666"/>
    <!-- 日期下说明默认颜色（非节日/节气） -->
    <SolidColorBrush x:Key="ExtraColor" Color="#333333"/>
    <!-- 节日高亮颜色（非纯农历节日/国际节日使用浅蓝） -->
    <SolidColorBrush x:Key="HolidayTextLightBlue" Color="#FF3399FF"/>
    <!-- 相邻月份浅灰颜色（用来补齐月视图前后空位） -->
    <SolidColorBrush x:Key="OutsideMonth-Foreground" Color="{conv:HexColor Value=#8a8a8ab4}"/>
    <!-- 今日边框颜色（今日日期或选中日期边框） -->
    <SolidColorBrush x:Key="TodayBorder" Color="#777777ff"/>
    <!-- 今日背景颜色（今日日期或选中日期背景） -->
    <SolidColorBrush x:Key="TodayBackground" Color="{conv:HexColor Value=#f2f2f2ff}"/>
    <!-- 放假角标颜色（“休”） -->
    <SolidColorBrush x:Key="HolidayBadgeColor" Color="#00B42A"/>
    <!-- 补班角标颜色（“班”） -->
    <SolidColorBrush x:Key="WorkdayBadgeColor" Color="#F53F3F"/>

    <SolidColorBrush x:Key="TestColor-2" Color="#fafafaff"/>

    <!-- 按钮相关颜色（背景、悬停、按压、边框） -->
    <SolidColorBrush x:Key="ButtonBg" Color="{conv:HexColor Value=#c666f3ff}"/>
    <SolidColorBrush x:Key="ButtonHoverBg" Color="{conv:HexColor Value=#9fd836d0}"/>
    <SolidColorBrush x:Key="ButtonPressedBg" Color="{conv:HexColor Value=#423ff7f3}"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="{conv:HexColor Value=#FFFCB8B8}"/>
    <!-- 下拉框背景、边框颜色 -->
    <SolidColorBrush x:Key="ComboBg" Color="{conv:HexColor Value=#c666f3ff}"/><!-- 下拉框背景颜色 -->
    <SolidColorBrush x:Key="ComboBorder" Color="{conv:HexColor Value=#FFFCB8B8}"/><!-- 下拉框边框颜色 -->
    <SolidColorBrush x:Key="ComboButtonForeground" Color="{conv:HexColor Value=#fafafaff}"/><!-- 下拉按钮字体颜色 -->

    <!--
      RoundedButton：圆角按钮样式
      - 修改圆角：CornerRadius="8"
      - 修改常态/悬停/按压背景：ButtonBg / ButtonHoverBg / ButtonPressedBg
      - 使用示例：<Button Style="{DynamicResource RoundedButton}" ... />
    -->
    <Style x:Key="RoundedButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 圆角边框容器：修改 CornerRadius 改变圆角大小 -->
                    <Border x:Name="border" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：改变背景为 Hover 色 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBg}"/>
                        </Trigger>
                        <!-- 按压：改变背景为 Pressed 色 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonPressedBg}"/>
                        </Trigger>
                        <!-- 禁用：降低不透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      RoundedComboBox：圆角下拉框样式
      - 修改圆角：CornerRadius="8"
      - 修改边框聚焦色：MonthTitleground
      - 使用示例：<ComboBox Style="{DynamicResource RoundedComboBox}" ... />
    -->
    <Style x:Key="RoundedComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ComboBg}"/><!-- 下拉框背景颜色 -->
        <Setter Property="BorderBrush" Value="{StaticResource ComboBorder}"/><!-- 下拉框边框颜色 -->
        <Setter Property="BorderThickness" Value="1"/><!-- 下拉框边框宽度 -->
        <Setter Property="Padding" Value="6,2"/><!-- 下拉框内边距 -->

        <!-- 关键：设置下拉选项居中对齐 -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 顶部整区可点击：使用 ToggleButton 包裹边框与内容 -->
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Margin="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- 圆角边框容器：保持与原样式一致 -->
                                        <Border x:Name="border" CornerRadius="2"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 当前选择文本（直接绑定到 SelectedItem） -->
                                                <TextBlock Grid.Column="0" Margin="6,2,6,2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Text="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <!-- 右侧箭头，保持尺寸不变 -->
                                                <Grid Grid.Column="1" Width="19" VerticalAlignment="Stretch">
                                                    <TextBlock x:Name="Arrow" Text="&#xE70D;"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{StaticResource ComboButtonForeground}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- 悬停：改变背景为 Hover 色 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBg}"/>
                                            </Trigger>
                                            <!-- 展开状态：箭头向上 -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/>
                                            </Trigger>
                                            <!-- 聚焦：改变边框为主题色 -->
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource MonthTitleground}"/>
                                            </Trigger>
                                            <!-- 禁用：降低不透明度 -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- 下拉弹出层：带圆角与滚动容器，可调整 PopupAnimation -->
                            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border CornerRadius="2" Background="{StaticResource ComboBg}" BorderBrush="{StaticResource ComboBorder}" BorderThickness="1" MaxHeight="200" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"> <!-- 关键：与ComboBox同宽 -->
                                    <!-- 滚动容器：按像素滚动，避免末尾空白（CanContentScroll="True" ，这会启用“按项滚动”）;并设置垂直卷轴可见，水平卷轴隐藏 -->
                                    <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <!-- 关键：ItemsPresenter不支持对齐属性，需要在ItemContainerStyle中设置 -->
                                        <ItemsPresenter/>  <!-- 这里会应用上面的居中对齐样式 -->
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    <!-- 触发器已移至 HeaderToggle.Template 中，保持交互一致 -->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      主题覆盖提示：
      - App 启动时会根据系统明/暗主题覆盖 Foreground / ForegroundLight / PanelBackground / ExtraColor 等键。
      - 若你希望固定主题而不随系统切换，可移除 App.xaml.cs 的 ApplySystemTheme 或注释对应赋值。
    -->
</ResourceDictionary>
