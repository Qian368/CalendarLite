<Window x:Class="CalendarLite.ImportUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CalendarLite.Resources"
        Title="导入节假日数据" Width="420" Height="160"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static res:Messages.ImportYearPrompt}" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" Name="YearBox" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Messages.BatchImportButton}" Width="95" Margin="0,0,8,0" Click="Batch_Click"/>
            <Button Content="本地文件导入" Width="95" Margin="0,0,8,0" Click="LocalImport_Click"/>
            <Button Content="确定" Width="75" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" Width="75" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>