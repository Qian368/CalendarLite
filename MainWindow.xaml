<Window x:Class="CalendarLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:CalendarLite.Resources"
        mc:Ignorable="d"
        Title="CalendarLite"
        Width="435" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource PanelBackground}"
        AllowsTransparency="False"
        Visibility="Hidden">
    <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部时间与日期描述 -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,10,0,10">
                <TextBlock Text="" Name="TimeText" FontSize="25" Foreground="{DynamicResource Foreground}" VerticalAlignment="Bottom"/>
                <TextBlock Text="&#x2003;&#x2003;&#x2003;&#x2003;" FontFamily="Consolas"/>
                <TextBlock Text="" Name="DateDescText" FontSize="20" Foreground="{DynamicResource ForegroundLight}" VerticalAlignment="Bottom"/>
            </StackPanel>

            <!-- 月份切换与标题 -->
            <DockPanel Grid.Row="1" Margin="0,8,0,8">
                <Button Content="{x:Static res:Messages.PrevMonth}" Style="{DynamicResource RoundedButton}" Width="50" Margin="0,0,8,0" Click="PrevMonth_Click"/>
                <Button Content="{x:Static res:Messages.TodayButton}" Style="{DynamicResource RoundedButton}" Width="50" Margin="0,0,8,0" Click="Today_Click"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ComboBox Name="YearSelect" Style="{DynamicResource RoundedComboBox}" Width="80" Margin="0,0,8,0" SelectionChanged="YearSelect_SelectionChanged" MaxDropDownHeight="200" /> 
                    <Button Content="{x:Static res:Messages.ImportButton}" Style="{DynamicResource RoundedButton}" Width="50" Margin="0,0,8,0" Click="Import_Click" />
                    <Button Content="{x:Static res:Messages.NextMonth}" Style="{DynamicResource RoundedButton}" Width="50" Click="NextMonth_Click" />
                </StackPanel>
                <TextBlock Text="" Name="MonthTitle" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource MonthTitleground}"/>
            </DockPanel>

            <!-- 日历网格 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 星期标题 -->
                <UniformGrid Rows="1" Columns="7" Grid.Row="0" Margin="0,15,0,15">
                    <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundLight}" FontSize="18" FontWeight="Bold" FontFamily="DengXian"/>
                    <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundLight}" FontSize="18" FontWeight="Bold" FontFamily="DengXian"/>
                    <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundLight}" FontSize="18" FontWeight="Bold" FontFamily="DengXian"/>
                    <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundLight}" FontSize="18" FontWeight="Bold" FontFamily="DengXian"/>
                    <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundLight}" FontSize="18" FontWeight="Bold" FontFamily="DengXian"/>
                    <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundLight}" FontSize="18" FontWeight="Bold" FontFamily="DengXian"/>
                    <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundLight}" FontSize="18" FontWeight="Bold" FontFamily="DengXian"/>
                </UniformGrid>

                <!-- 日期单元格 -->
                <ItemsControl Grid.Row="1" Name="CalendarItems" Margin="0,5,0,25">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" Background="Transparent" MouseLeftButtonUp="Day_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Day}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{Binding DayForeground}"/>
                                    <!-- 放假调班信息 -->
                                    <TextBlock Grid.Column="1" Text="{Binding BadgeText}" Foreground="{Binding BadgeColor}" FontSize="10"/>
                                    <!-- 日期下面的农历信息 -->
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ExtraInfo}" FontSize="11" Foreground="{Binding ExtraForeground}" FontWeight="{Binding ExtraFontWeight}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>
